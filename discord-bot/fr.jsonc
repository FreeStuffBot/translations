  "settings_filter_stores_none": "(Tout désactivé)",

  // Show bad quality games
  "settings_filter_trash_1": "Afficher les jeux de mauvaise qualité",

  // By default we won't show you games with bad ratings or of general poor quality
  "settings_filter_trash_2": "Par défaut, nous ne t'afficherons pas les jeux mal notés ou de qualité généralement médiocre",

  // Filter Settings
  "settings_filter_ui_1": "Paramètres du filtre",

  // There are a lot of free games out there, some more interesting than others. In order to not flood your precious Discord server with spam we have some options for you to decide which games you like to see:
  "settings_filter_ui_2": "Il existe de nombreux jeux gratuits, certains plus intéressants que d'autres. Afin de ne pas inonder votre précieux serveur Discord de spam, nous vous proposons quelques options pour que vous puissiez décider des jeux que vous souhaitez voir :",

  // Read the guide
  "settings_generic_help_solution_guide_1": "Lire le guide",

  // We have website prepared to walk you through the entire setup and explain everything along the way. Please check it out if you're lost!
  "settings_generic_help_solution_guide_2": "Nous avons préparé un site web pour te guider à travers toute la configuration et tout t'expliquer. N'hésite pas à le consulter si tu es perdu !",

  // Join our support server
  "settings_generic_help_solution_server_1": "Rejoins notre serveur d'assistance",

  // The guide didn't help you? We have a support server to help you out and answer all your questions. Feel free to hop in!
  "settings_generic_help_solution_server_2": "Le guide ne t'a pas aidé ? Nous avons un serveur d'assistance pour t'aider et répondre à toutes tes questions. Rejoins-nous !",

  // Something failed while exporting your data, we are very sorry. You can reach out to us and manually request a copy of your data via team@freestuffbot.xyz - Please include your server id in the E-Mail. Thanks.
  "settings_guilddata_data_failed": "Un problème est survenu lors de l'exportation de tes données, nous en sommes vraiment désolés. Tu peux nous contacter et demander manuellement une copie de tes données via team@freestuffbot.xyz - Pense à inclure l'identifiant de ton serveur dans l'e-mail. Merci.",

  // Please click the Download button below to download your data. The button will only work one time, run the command again to download again. Do not share the link with anyone!
  "settings_guilddata_data_ready": "Clique sur le bouton Télécharger ci-dessous pour télécharger tes données. Ce bouton ne fonctionne qu'une seule fois, relance la commande pour télécharger à nouveau. Ne partage ce lien avec personne !",

  // Delete Server Data
  "settings_guilddata_delete_button": "Supprime les données",

  // Are you sure?
  "settings_guilddata_delete_dialogue_confirmation_1": "Vous êtes sûr ?",

  // Once you click the button below there is no going back!
  "settings_guilddata_delete_dialogue_confirmation_2": "Une fois que vous aurez cliqué sur le bouton ci-dessous, vous ne pourrez plus revenir en arrière !",

  // Slow down!
  "settings_guilddata_delete_dialogue_cooldown_1": "Doucement !",

  // Looks like someone already deleted this server's data in the past 12h. Please try again later!
  "settings_guilddata_delete_dialogue_cooldown_2": "Il semble que quelqu'un ait déjà supprimé les données de ce serveur au cours des 12 dernières heures. Veuillez réessayer plus tard !",

  // Only an admin can do this
  "settings_guilddata_delete_dialogue_not_allowed_1": "Seul un administrateur peut faire ça",

  // Please ask a server admin if you really really wanna do this.
  "settings_guilddata_delete_dialogue_not_allowed_2": "Veuillez demander à un administrateur du serveur si vous voulez vraiment faire cela.",

  // Success!
  "settings_guilddata_delete_success_1": "Succès !",

  // Your server's data has been deleted and reset to default settings!
  "settings_guilddata_delete_success_2": "Les données de votre serveur ont été supprimées et réinitialisées aux paramètres par défaut !",

  // Uh... that's a bit embarrassing now... There was an error exporting your data. Please [contact our team]({invite}) to get your data.
  "settings_guilddata_display_error": "Euh… c'est un peu embarrassant maintenant… Une erreur s'est produite lors de l'exportation de vos données. Veuillez [contacter notre équipe]({invite}) pour récupérer vos données.\n",

  // Download Data
  "settings_guilddata_download": "Télécharger les données",

  // Okie dokie, data's coming in hot:
  "settings_guilddata_success_1": "Okie dokie, les données arrivent à grands pas :",

  // English with the metric system
  "settings_language_list_desc_english_eu": "L'anglais avec le système métrique",

  // English with the imperial system
  "settings_language_list_desc_english_us": "L'anglais avec le système impérial",

  // English with football fields per pizza slice
  "settings_language_list_desc_english_us_easteregg": "L'anglais avec des armes et des bières",

  // {language} by {translators}
  "settings_language_list_desc_generic": "{language} par {translators}",

  // Your Active Notifications
  "settings_main_active_notifications": "Tes notifications actives",

  // Click to add a news source
  "settings_main_add_first_source_placeholder": "Clique pour ajouter une source d'actus",

  // Add Notifications
  "settings_main_add_notifications": "Ajouter des notifications",

  // You are subscribed to everything!
  "settings_main_add_sources_empty_1": "Tu es abonné à tout !",

  // There's nothing else you can be notified about currently.
  "settings_main_add_sources_empty_2": "Il n'y a rien d'autre sur lequel tu puisses être notifié pour le moment.",

  // Click to add new sources
  "settings_main_add_sources_placeholder": "Clique pour ajouter de nouvelles sources",

  // Display Settings
  "settings_main_btn_display": "Paramètres d'affichage",

  // Filter Settings
  "settings_main_btn_filter": "Paramètres du filtre",

  // Other Settings
  "settings_main_btn_general": "Autres paramètres",

  // Need help?
  "settings_main_btn_help": "Besoin d'aide ?",

  // Advanced
  "settings_main_btn_more": "Plus",

  // Notification Settings
  "settings_main_btn_notifications": "Paramètres de notification",

  // Tl;dr
  "settings_main_help_solution_tldr_1": "TL;DR",

  // 1. Click on `{text}` above\n2. Select a source, can be any you want. Those with {premium} require FreeStuff Premium, **all others don't**\n3. On the page that opens select a channel for the bot to post in\n4. Done!
  "settings_main_help_solution_tldr_2": "1. Clique sur `{text}` ci-dessus\n2. Choisis une source, celle de ton choix. Celles avec {premium} nécessitent FreeStuff Premium, **toutes les autres non**\n3. Sur la page qui s'ouvre, choisis un salon où le bot postera\n4. Et voilà !",

  // You can edit your notification settings by clicking the buttons above.
  "settings_main_notifications_edit_hint": "Tu peux modifier tes paramètres de notification en cliquant sur les boutons ci-dessus.",

  // Suggested for you
  "settings_main_suggested_categories_1": "Suggéré pour toi",

  // {promo} {dash} Select from the list below to learn more!
  "settings_main_suggested_categories_2": "{promo} {dash} Choisis dans la liste ci-dessous pour en savoir plus !",

  // Settings
  "settings_main_ui_1": "Paramètres",

  // Looks like you still didn't finish setting up the bot :eyes:\n\nWhy don't you start by picking a channel for me to send free games to?
  "settings_main_ui_2_guided_channel_delayed": "On dirait que tu n'as toujours pas fini de configurer le bot :eyes:\n\nPourquoi ne pas commencer par choisir un salon sur lequel j'enverrai des jeux gratuits ?",

  // Welcome to FreeStuff :wave:\n\nGlad you found your way to the settings page! Let's get started by picking a channel I can use to keep you and your friends up to date with free games! Click the blue button below to continue:
  "settings_main_ui_2_guided_channel_normal": "Bienvenue sur FreeStuff :wave:\n\nContent que tu aies trouvé le chemin de la page des paramètres ! Commençons par choisir un salon que je peux utiliser pour vous tenir au courant, vous et vos amis, des jeux gratuits ! Cliquez sur le bouton bleu ci-dessous pour continuer :",

  // You got some more settings to check out! I'm talking about themes and currency options and whatnot. Interested? The blue button will get you there!
  "settings_main_ui_2_guided_display_delayed": "Vous avez d'autres paramètres à vérifier ! Je parle de thèmes, d'options de devises et d'autres choses encore. Vous êtes intéressé ? Le bouton bleu vous y conduira !",

  // Perfect! Last checkpoint on the list is the display settings. It's absolutely worth giving them a quick look!
  "settings_main_ui_2_guided_display_normal": "Parfait ! Le dernier point de contrôle sur la liste concerne les paramètres d'affichage. Cela vaut vraiment la peine d'y jeter un coup d'œil !",

  // Welcome back! You might be missing out on some free games because the filter options are not configured to your likings! Better check them out real quick, it doesn't take long :eyes:
  "settings_main_ui_2_guided_filter_delayed": "Bienvenue ! Il se peut que tu rates certains jeux gratuits parce que les options de filtrage ne sont pas configurées à ton goût ! Tu ferais mieux de les vérifier rapidement, ça ne prend pas beaucoup de temps :eyes:",

  // Okay awesome, let's continue with filter settings. You might be missing out on some games if you don't check those out!
  "settings_main_ui_2_guided_filter_normal": "Ok génial, continuons avec les paramètres des filtres. Vous risquez de rater des jeux si vous ne les vérifiez pas !",

  // Awesome, you're done with setting up the FreeStuff Bot! Enjoy your free games! :partying_face:\n\nLooking for other people to talk about free games? [Join our Discord Server]({invite})\n\n*You can always return to this page using /settings*
  "settings_main_ui_2_guided_finished": "Génial, tu as fini de configurer le bot FreeStuff ! Profite de tes jeux gratuits :partying_face:\n\nVous cherchez d'autres personnes pour parler de jeux gratuits ? [Rejoignez notre serveur Discord]({invite})\n\n*Vous pouvez toujours revenir à cette page en utilisant /settings*",

  // Wanna continue setting up the bot?\nI'd suggest you check out role mentions next! Just click the button below to see what's possible!
  "settings_main_ui_2_guided_role_delayed": "Vous voulez continuer à configurer le bot ?\nJe vous suggère d'aller voir du côté des mentions de rôle ! Cliquez simplement sur le bouton ci-dessous pour voir ce qui est possible !",

  // Good job! Next up, maybe wanna get notified when a game becomes free? I'm talking about pinging a role or maybe even @everyone?\nClick the button below to see what's possible :eyes:
  "settings_main_ui_2_guided_role_normal": "Bon travail ! Ensuite, vous voulez peut-être être notifié quand un jeu devient gratuit ? Je parle d'envoyer un ping à un rôle ou peut-être même à @everyone ?\nCliquez sur le bouton ci-dessous pour voir ce qui est possible :eyes:",

  // Hey there!\n\nCan't seem to find a setting? Need help with configuring the bot properly? Or have any other questions? [Click here for a Guide]({guide}) that walks you through everything or alternatively [join our Support Server]({invite}) for personal help.
  "settings_main_ui_2_regular": "Hey !\n\nVous n'arrivez pas à trouver un paramètre ? Vous avez besoin d'aide pour configurer le bot correctement ? Ou vous avez d'autres questions ? [Cliquez ici pour obtenir un guide]({guide}) qui vous guidera tout au long du processus ou bien [rejoignez notre serveur d'assistance]({invite}) pour obtenir une aide personnalisée.",

  // Welcome to FreeStuff!\n\nIf you want to get **automatic notifications** for **free games**, you need to **add** at least **one source** below. You can always come back later and add or remove more sources.
  "settings_main_welcome": "Bienvenue sur FreeStuff !\n\nSi tu veux recevoir des **notifications automatiques** pour les **jeux gratuits**, tu dois **ajouter** au moins **une source** ci-dessous. Tu pourras toujours revenir plus tard pour en ajouter ou en retirer.",

  // Pick a type of notification from the list below to get started!
  "settings_main_welcome_extra": "Choisis un type de notification dans la liste ci-dessous pour commencer !",

  // With beta enabled you to get updates and new features early. Be aware that this might also include unstable or experimental features and updates. You might also occasionally get asked for feedback if opted in.
  "settings_more_beta_description": "En activant la bêta, tu peux accéder aux mises à jour et nouvelles fonctionnalités en avance. Attention, cela peut inclure des fonctionnalités instables ou expérimentales. Tu pourrais aussi recevoir occasionnellement des demandes d'avis si tu y participes.",

  // Beta
  "settings_more_beta_name": "Bêta",

  // Opt out of Beta
  "settings_more_beta_off_prompt": "Se désinscrire de la bêta",

  // You're not in beta!
  "settings_more_beta_off_state": "Vous n'êtes pas en bêta !",

  // Opt in to Beta
  "settings_more_beta_on_prompt": "S'inscrire à la beta",

  // You're in beta!
  "settings_more_beta_on_state": "Vous êtes en bêta !",

  // When Boring Mode is enabled you are opted out from april fools events and things might be more dull in general.
  "settings_more_boringmode_description": "Lorsque le mode Ennuyeux est activé, tu ne participes pas aux événements du 1er avril et les choses sont généralement plus sobres.",

  // Boring Mode
  "settings_more_boringmode_name": "Mode Ennuyeux",

  // Disable Boring Mode
  "settings_more_boringmode_off_prompt": "Désactiver le Mode Ennuyeux",

  // Boring Mode is off
  "settings_more_boringmode_off_state": "Le Mode Ennuyeux est désactivé",

  // Enable Boring Mode
  "settings_more_boringmode_on_prompt": "Activer le Mode Ennuyeux",

  // Boring Mode is on
  "settings_more_boringmode_on_state": "Le Mode Ennuyeux est activé",

  // Show Debug Info
  "settings_more_btn_debug": "Afficher les infos de débogage",

  // View Server Data
  "settings_more_btn_guilddata": "Voir les données serveur",

  // Your Data
  "settings_more_data_label": "Tes données",

  // Mysterious Button
  "settings_more_mysterious_button": "Bouton mystérieux",

  // Advanced Options
  "settings_more_ui_1": "Plus",

  // You need \"Manage Server\" permissions to edit this
  "settings_permission_disclaimer": "Vous devez avoir les droits de \"Gérer le serveur\" pour modifier cette information",

  // Add Role
  "settings_role_add_role": "Ajouter un rôle",

  // @everyone
  "settings_role_list_everyone_1": "@everyone",

  // Ping everyone. That's a lot of people.
  "settings_role_list_everyone_2": "Ping tout le monde. C'est beaucoup de monde.",

  // Some roles might be hidden because you have too many to show at once. Move your role to the top if you can't find it in the list!
  "settings_role_list_hidden_overflow_disclaimer": "Certains rôles peuvent être cachés parce que vous en avez trop à afficher en même temps. Déplacez votre rôle vers le haut si vous ne le trouvez pas dans la liste !",

  // Some roles might be hidden because the bot doesn't have the `Mention All Roles` permission!
  "settings_role_list_hidden_permissions_disclaimer": "Certains rôles peuvent être cachés parce que le bot n'a pas la permission de \"Mentionner tous les rôles\" !",

  // Disable Mentions
  "settings_role_list_no_mention_1": "Désactive les mentions",

  // Do not ping anyone.
  "settings_role_list_no_mention_2": "Ne pinguer personne.",

  // None selected
  "settings_role_list_remove_role_1": "Aucun sélectionné",

  // Click here to remove this role
  "settings_role_list_remove_role_2": "Clique ici pour retirer ce rôle",

  // Notification Settings
  "settings_role_ui_1": "Paramètres de notification",

  // Pick a role to ping when a new game becomes free!
  "settings_role_ui_2": "Choisissez un rôle à pinguer lorsqu'un nouveau jeu devient gratuit !",

  // More
  "settings_sub_btn_more": "Plus",

  // Oopsie woopsie!
  "settings_sub_help_solution_premium_locked_1": "Oups là là !",

  // {name} is only available to FreeStuff Premium users. You can either subscribe to FreeStuff Premium to receive notifications for {name} or **click the back button and pick a different source**. There are many free ones available!
  "settings_sub_help_solution_premium_locked_2": "{name} est réservé aux utilisateurs de FreeStuff Premium. Tu peux soit t'abonner à FreeStuff Premium pour recevoir les notifications de {name}, soit **cliquer sur le bouton retour et choisir une autre source**. Il y en a plein de gratuites !",

  // Tl;dr
  "settings_sub_help_solution_tldr_1": "TL;DR",

  // 1. Click on the dropdown menu above\n2. Select a channel for the bot to send notifications to\n3. And that's it, you're done! You will now receive automatic notifications!\n4. Optional: Click on the buttons above to customize things
  "settings_sub_help_solution_tldr_2": "1. Clique sur le menu déroulant ci-dessus\n2. Choisis un salon où le bot enverra les notifications\n3. Et voilà, c'est terminé ! Tu recevras désormais les notifications automatiques !\n4. Facultatif : clique sur les boutons ci-dessus pour personnaliser tout ça",

  // {subscription} is a premium subscription. If you want to receive news from this category [click here for more info.]({website})
  "settings_subscription_locked_premium": "{subscription} est un abonnement premium. Si tu souhaites recevoir les actualités de cette catégorie, [clique ici pour plus d'infos.]({website})",

  // More
  "settings_subscription_more_1": "Plus",

  // Resend Notifications
  "settings_subscription_more_resend_1": "Renvoyer les notifications",

  // You can re-send a message for all offers in that category that are still valid. Accidentally deleted a message? Changed settings? Or just want the same notification twice? This is for you!
  "settings_subscription_more_resend_2": "Tu peux renvoyer un message pour toutes les offres encore valides dans cette catégorie. Message supprimé par erreur ? Paramètres modifiés ? Ou tu veux juste la même notification deux fois ? C'est fait pour toi !",

  // Resend
  "settings_subscription_more_resend_btn": "Renvoyer",

  // Test Message
  "settings_subscription_more_test_1": "Message de test",

  // You can send a test message with all the options you've configured. Use this to make 100% sure that everything works. Be aware that this might ping people, if set up to do so.
  "settings_subscription_more_test_2": "Tu peux envoyer un message de test avec toutes les options que tu as configurées. Utilise ceci pour être sûr à 100 % que tout fonctionne. Attention, cela peut mentionner des personnes si c'est configuré pour.",

  // Send Test
  "settings_subscription_more_test_btn": "Envoyer le test",

  // More
  "settings_subscription_more_ui_1": "Plus",

  // **Send Test Message** sends a test message with all the options you've configured. Use this to make 100% sure that everything works. Be aware that this might ping people, if set up to do so.\n\n**Re-send Messages** will re-send a message for all offers in that category that are still valid. Accidentally deleted a message? Changed settings? Or just want the same notification twice? This button is for you!
  "settings_subscription_more_ui_2": "**Envoyer un message de test** envoie un message de test avec toutes les options que tu as configurées. Utilise ceci pour t'assurer à 100 % que tout fonctionne. Sache que cela peut mentionner des membres si c'est configuré ainsi.\n\n**Renvoyer les messages** renverra un message pour toutes les offres de cette catégorie qui sont encore valides. Un message supprimé par erreur ? Des paramètres modifiés ? Ou simplement envie d'avoir deux fois la même notification ? Ce bouton est fait pour toi !",

  // Click here to get notified
  "settings_subscription_not_subscribed_1": "Clique ici pour recevoir les notifications",

  // Pick a channel below to enable automatic notifications for {subscription}
  "settings_subscription_not_subscribed_2": "Choisis un salon ci-dessous pour activer les notifications automatiques pour {subscription}",

  // Your Premium subscription expired. We have paused your notifications for {subscription} until you resubscribe.
  "settings_subscription_premium_expired": "Ton abonnement Premium a expiré. Nous avons mis en pause tes notifications pour {subscription} jusqu'à ce que tu te réabonnes.",

  // {subscription} is a premium subscription. You can subscribe.
  "settings_subscription_unlocked_premium": "{subscription} est un abonnement premium. Tu peux t'abonner.",

  // Unsubscribe {subscription}
  "settings_subscription_unsubscribe_1": "Se désabonner de {subscription}",

  // You will stop receiving games from this category.
  "settings_subscription_unsubscribe_2": "Tu ne recevras plus les jeux de cette catégorie.",

  // {user} used {command}
  "slash_command_source": "{user} a utilisé {command}",

  // Sign up to get a notification for when usually paid assets receive a temporary 100% discount. This means you can get them for free and keep them forever.\nYou can filter by type, compatibility, store and more.
  "subscription_assets_description": "Abonne-toi pour recevoir une notification lorsque des assets habituellement payants bénéficient d'une réduction temporaire de 100 %. Cela signifie que tu peux les obtenir gratuitement et les garder pour toujours.\nTu peux filtrer par type, compatibilité, boutique et plus encore.",

  // 3d Models, Textures, Sounds and more
  "subscription_assets_hint": "Modèles 3D, textures, sons et plus",

  // Gamedev Assets
  "subscription_assets_name": "Assets de dev",

  // Are you a game developer or want to become one? With {name} you get a notification when paid game assets go free for a limited time! Get 3D models, textures, sounds and more!
  "subscription_assets_promo": "Tu es développeur de jeux ou tu veux le devenir ? Avec {name}, reçois une notification quand des assets de jeu payants deviennent gratuits pour une durée limitée ! Récupère des modèles 3D, des textures, des sons et plus encore !",

  // Uhhhh uhmmm uhhh uhhhhhhhhmmmuhhhhhh yeahhh uhhhhh no.
  "subscription_debug_promo": "Euuuuh hummm euuuh euuuuuhhhhhhhmmmeuuuuh ouaiiis euuuuh non.",

  // Sign up to get notified about any games or other content newly added to Game Pass. You require a Game Pass subscription to make use of these offers.\nYou can filter by price and quality.
  "subscription_gamepass_description": "Abonne-toi pour être notifié de chaque jeu ou nouveau contenu ajouté au Game Pass. Tu as besoin d'un abonnement Game Pass pour profiter de ces offres.\nTu peux filtrer par prix et qualité.",

  // New arrivals on Xbox Game Pass.
  "subscription_gamepass_hint": "Nouveautés sur le Xbox Game Pass.",

  // Game Pass
  "subscription_gamepass_name": "Xbox Game Pass",

  // Game pass users, we've got you! Check out {name} to receive all new arrivals directly in Discord!
  "subscription_gamepass_promo": "Toujours à l'affût de nouveaux jeux à tester sur le Xbox Game Pass ? Avec {name}, tu seras toujours le premier informé des nouveaux ajouts !",

  // Sign up to get a notification when any game gets a 100% discount for a limited amount of time. This means you can get them for free and even keep them after the sale is over. Nothing to lose.\nYou can filter by price, platform and quality.
  "subscription_keep_description": "Abonne-toi pour recevoir des notifications sur les jeux bénéficiant d'une réduction temporaire de 100 %. Cela signifie que tu peux les obtenir gratuitement et les garder pour toujours.\nTu peux filtrer par prix, boutique et qualité.",

  // Games with a temporary 100% discount.
  "subscription_keep_hint": "Gratuit à récupérer et à garder pour toujours.",

  // 100% Discount
  "subscription_keep_name": "Jeux gratuits",

  // {name} is a must have! Receive notifications for regular, paid games at a temporary 100% discount! Claim in time and keep them forever!
  "subscription_keep_promo": "Tu veux accumuler encore plus de jeux ? Avec {name}, reçois une notification chaque fois qu'un jeu bénéficie d'une réduction de 100 % pour une durée limitée ! Récupère-le une fois, garde-le pour toujours !",

  // Are you into mobile gaming? Did you know there's free games for you too?
  "subscription_mobile_description": "Abonne-toi pour être prévenu des jeux pour iOS et Android habituellement payants qui bénéficient d'une réduction temporaire de 100 %.\nTu peux filtrer par plateforme et qualité.",

  // Mobile games with a 100% discount.
  "subscription_mobile_hint": "Jeux gratuits pour Android et iOS.",

  // Mobile Games
  "subscription_mobile_name": "Jeux mobiles",

  // Do you own a phone? If so, {name} has you covered with temporary 100% discounts on mobile games!
  "subscription_mobile_promo": "Tu as un smartphone ? Si oui, {name} s'occupe de tout avec des réductions temporaires de 100 % sur les jeux mobiles !",

  // Big news. Big releases. Big offers. Never ads or paid posts.\nSubscribe to get a hand-curated selection of news and big things happening.
  "subscription_news_description": "Grosses actus. Grosses sorties. Grosses offres. Jamais de pub ni de posts sponsorisés.\nAbonne-toi pour recevoir une sélection minutieuse d'actualités et d'événements majeurs.",

  // Big news from the gaming world.
  "subscription_news_hint": "Les grosses actus du monde du jeu vidéo.",

  // Gaming News
  "subscription_news_name": "Actualités gaming",

  // Do you regularly miss out on big things happening? Check out {name} where the FreeStuff team lets you know when GTA6 is delayed again or when Fortnite is deleted.
  "subscription_news_promo": "Tu rates régulièrement les gros événements ? Découvre {name}, où l'équipe FreeStuff te prévient quand GTA 6 est encore repoussé ou quand Fortnite est supprimé.",

  // Sign up to see all sorts of other offers that are available at a temporary 100% discount. This means DLCs, Addons, Ingame Content, Store Items or something else entirely, but always free to claim and keep forever.\nYou can filter by price, platform and product type.
  "subscription_other_description": "Abonne-toi pour voir toutes sortes d'autres offres avec une réduction temporaire de 100 %. Cela inclut DLC, extensions, contenu en jeu, objets de boutique ou toute autre chose, mais toujours gratuit à récupérer et à garder pour toujours.\nTu peux filtrer par prix, plateforme et type de produit.",

  // DLCs, Addons, Ingame Content & more at 100% off.
  "subscription_other_hint": "DLC, extensions, contenu en jeu et plus à -100 %.",

  // DLCs & More
  "subscription_other_name": "DLC et plus",

  // Check out {name} for news about any 100% discounted DLCs, Addons or Ingame Content from all the same places you know and love!
  "subscription_other_promo": "Jette un œil à {name} pour être au courant des DLC, extensions ou contenus en jeu à -100 % provenant de toutes les plateformes que tu aimes tant !",

  // Sign up to get notified about any games or other content newly added to Prime Gaming. You require a Prime Gaming subscription to make use of these offers. \nYou can filter by type, price and quality.
  "subscription_prime_description": "Abonne-toi pour être notifié de chaque jeu ou contenu récemment ajouté sur Prime Gaming. Tu as besoin d'un abonnement Prime Gaming pour profiter de ces offres.\nTu peux filtrer par type, prix et qualité.",

  // New arrivals on Prime Gaming.
  "subscription_prime_hint": "Nouveautés sur Prime Gaming.",

  // Prime Gaming
  "subscription_prime_name": "Prime Gaming",

  // Got an Amazon Prime Gaming subscription or thinking of getting one? With our {name} notifications you'll stay ahead and never miss out!
  "subscription_prime_promo": "Tu as un abonnement Amazon Prime Gaming ou tu penses en prendre un ? Avec nos notifications {name}, sois toujours au courant et ne rate plus rien !",

  // Prime Gaming: Games
  "subscription_primegames_name": "Prime Gaming : Jeux",

  // Prime Gaming: Loot
  "subscription_primeloot_name": "Prime Gaming : Butin",

  // Sign up to receive notifications about games that you can try out and play for free for a limited amount of time. You cannot keep those games after the time is over and have to buy them to continue playing.\nYou can filter by price, platform and quality.
  "subscription_timed_description": "Abonne-toi pour recevoir des notifications sur les jeux que tu peux tester et jouer gratuitement pendant une durée limitée. Tu ne peux pas garder ces jeux une fois le temps écoulé et tu devras les acheter pour continuer à jouer.\nTu peux filtrer par prix, plateforme et qualité.",

  // Games that are temporarily free to play.
  "subscription_timed_hint": "Jeux temporairement jouables gratuitement.",

  // Free Weekend
  "subscription_timed_name": "Week-end gratuit",

  // Into exploring new games? {name} got you covered, with news about games that are temporarily free to play, usually for a couple of days.
  "subscription_timed_promo": "Envie de découvrir de nouveaux jeux ? {name} s'occupe de toi, avec des actualités sur les jeux temporairement jouables gratuitement, généralement pendant quelques jours.",

  // Terms of Service
  "terms_of_service": "Conditions d'utilisation",

  // You cannot get less than this
  "theme_eight_desc": "Vous ne pouvez pas obtenir moins que ça",

  // Bare minimum
  "theme_eight_name": "Minimum vital",

  // A theme with minimal extra info
  "theme_five_desc": "Un thème avec un minimum d'informations",

  // Keep it simple
  "theme_five_name": "Restez simple",

  // Only weird people chose this
  "theme_four_desc": "Vous avez un modem 56k ? Vraiment ?",

  // More info less images!
  "theme_four_name": "ASCII",

  // If you need some context but don't like embeds
  "theme_nine_desc": "J'te l'dis, c'est g-r-a-t-u-i-t !",

  // Text only!
  "theme_nine_name": "Texte seulement !",

  // Pretty basic
  "theme_one_desc": "Assez basique",

  // Default Theme
  "theme_one_name": "Thème par défaut",

  // It's literally just the link
  "theme_seven_desc": "C'est littéralement juste le lien",

  // Literally just the link
  "theme_seven_name": "URL",

  // A theme with almost minimal extra info
  "theme_six_desc": "Pourquoi s'embêter avec du texte franchement…",

  // Images are cool!
  "theme_six_name": "Les images sont cool !",

  // For ArchiSteamFarm users and alike
  "theme_ten_desc": "Pour les utilisateurs d'ArchiSteamFarm",

  // Advanced
  "theme_ten_name": "Avancé",

  // With a short description and ratings
  "theme_three_desc": "Avec une courte description et des évaluations",

  // More info!
  "theme_three_name": "Plus d'informations !",

  // If you don't like images
  "theme_two_desc": "Une très belle économie de bande passante",

  // No photos please!
  "theme_two_name": "Sans images",

  // We send a message in your channel. That's all.

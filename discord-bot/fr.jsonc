  // Now that's a twist!
  "cmd_resend_all_filtered_out_1": "Ça c'est un rebondissement !",

  // There are games free, but your filter settings do not allow a single one of them to be announced! If you did not intend this, check your filter settings again.
  "cmd_resend_all_filtered_out_2": "Il y a bien des jeux gratuits, mais tes filtres n'en autorisent aucun à être annoncé ! Si ce n'était pas voulu, vérifie à nouveau tes paramètres de filtrage.",

  // The webhook in {channel} is broken.
  "cmd_resend_invalid_webhook_1": "Le webhook dans {channel} est cassé.",

  // That sounds scary. In order to fix this try to change the channel to some different one and then back to {channel}. If this error persists please contact support!
  "cmd_resend_invalid_webhook_2": "Ça fait un peu peur. Pour régler ça, essaie de changer de salon vers un autre, puis reviens sur {channel}. Si l'erreur persiste, contacte le support !",

  // Whoops!
  "cmd_resend_nosend_1": "Oups !",

  // Looks like I don't have the permission to send messages in {channel}!
  "cmd_resend_nosend_2": "On dirait que FreeStuff n'a pas la permission d'envoyer des messages dans {channel} !",

  // Uh oh!
  "cmd_resend_nothing_free_1": "Euh…",

  // There's not a single game from this category for free right now... How could that have happened :thinking:
  "cmd_resend_nothing_free_2": "Il n'y a pas un seul jeu avec une remise de 100% en ce moment… Comment cela a-t-il pu arriver ? :thinking:",

  // Aaaaaand there it goes!
  "cmd_resend_success_1": "Eeeeeet c'est parti !",

  // Check out {channel}!
  "cmd_resend_success_2": "Consultez {channel} !",


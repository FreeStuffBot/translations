  // Show Store Items
  "settings_filter_kinds_storeitem_1": "Afficher les objets de boutique",

  // Things like steam point shop items
  "settings_filter_kinds_storeitem_2": "Objets de la boutique de points Steam, etc.",

  // Send all games. Every. Single. One.
  "settings_filter_price_class_desc_everything": "Affiche tous les jeux. Tous. Absolument. Tous.",

  // Only send games worth {price} or more
  "settings_filter_price_class_desc_generic": "N'envoyez que des jeux d'une valeur >= à {price}.",


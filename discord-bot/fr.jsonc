  // About Premium
  "premium_promo_button": "À propos de Premium",

  // No more manual clicking! With FreeStuff premium you can have the bot automatically publish every notification you receive in announcement channels!
  "premium_upsell_autopublish_description": "Tu veux des messages automatiques ? C'est déjà fait, pas besoin de premium !\nTu veux que le bot publie automatiquement chaque notification reçue dans les salons d'annonces pour les relayer à tes abonnés ? C'est là que le premium entre en jeu : gagne du temps et laisse-nous faire le travail pour toi !",

  // Get premium to use auto publish!
  "premium_upsell_autopublish_title": "Passe à Premium pour utiliser la publication automatique !",

  // With FreeStuff premium you can have the bot automatically react to every notification you receive!
  "premium_upsell_autoreact_description": "Avec FreeStuff Premium, tu peux faire réagir le bot automatiquement à chaque notification que tu reçois !",

  // Get premium to use auto reactions!
  "premium_upsell_autoreact_title": "Passe à Premium pour utiliser les réactions automatiques !",

  // With FreeStuff premium you can upload your own image for FreeStuff to use as the profile picture. You can also change the name to whatever you like. Make it blend in to your server!
  "premium_upsell_botprofile_description": "Avec FreeStuff Premium, tu peux importer ta propre image pour que FreeStuff l'utilise comme photo de profil. Tu peux aussi changer son nom comme bon te semble pour qu'il s'intègre parfaitement à ton serveur !",

  // Get premium to change the bot's profile!
  "premium_upsell_botprofile_title": "Passe à Premium pour modifier le profil du bot !",

  // If you are happy with the one role you selected, you don't need to get premium. Your changes are already saved!\nIf you do want to ping more than one role however, you can do this with premium!
  "premium_upsell_multiping_description": "Si le rôle unique que tu as sélectionné te convient, tu n'as pas besoin de Premium. Tes modifications sont déjà enregistrées !\nSi tu veux mentionner plus d'un rôle en revanche, tu peux le faire grâce à Premium !",

  // Get premium to ping more than one role!
  "premium_upsell_multiping_title": "Passe à Premium pour mentionner plusieurs rôles !",

  // With FreeStuff premium you can have the bot automatically create threads for every notification you receive!\nYou can either have a thread below each notification or let it create a new thread to post the notification in. The choice is your's!
  "premium_upsell_threadopts_description": "Avec FreeStuff Premium, tu peux demander au bot de créer automatiquement des fils de discussion pour chaque notification reçue !\nTu peux soit avoir un fil sous chaque notification, soit le laisser créer un nouveau fil pour y poster la notification. À toi de choisir !",

  // Get premium to create threads!
  "premium_upsell_threadopts_title": "Passe à Premium pour créer des fils !",


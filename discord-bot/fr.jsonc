  // Slow down! You can only reload this list every {interval} seconds!
  "refresh_channel_timeout": "Doucement ! Tu ne peux recharger cette liste que toutes les {interval} secondes !",

  // Channel list refreshed
  "refresh_channels_success": "Liste des salons actualisée",

  // You are too fast! For safety reasons we can only allow you to press that button once every {interval} seconds!\\nWith best regards, John FreeStuff, founder of FreeStuff
  "refresh_channels_timeout": "Tu vas trop vite ! Pour des raisons de sécurité, nous ne pouvons t'autoriser à appuyer sur ce bouton qu'une fois toutes les {interval} secondes !\nBien cordialement, John FreeStuff, fondateur de FreeStuff",

  // Refresh List
  "refresh_role_list": "Actualiser la liste",

  // Slow down! You can only reload this list every {interval} seconds!
  "refresh_role_timeout": "Doucement ! Tu ne peux recharger cette liste que toutes les {interval} secondes !",

  // Welcome to FreeStuff!
  "settings2_main_1_first_time": "Bienvenue sur FreeStuff !",

  // FreeStuff Settings
  "settings2_main_1_regular": "Paramètres de FreeStuff",

  // Welcome back! Manage your subscriptions below. Click on a category (blue button) for more info and to change settings.\nNeed help? Check out our [support server]({invite}) or [guide]({guide})!
  "settings2_main_2_regular": "Ravi de te revoir ! Gère tes abonnements ci-dessous. Clique sur une catégorie (bouton bleu) pour plus d'infos et pour modifier les paramètres.\nBesoin d'aide ? Viens sur notre [serveur d'assistance]({invite}) ou consulte notre [guide]({guide}) !",

  // Disable Auto Publish
  "settings_auto_publish_off_prompt": "Désactiver la publication automatique",

  // Auto Publish Disabled
  "settings_auto_publish_off_state": "Publication automatique désactivée",

  // Enable Auto Publish
  "settings_auto_publish_on_prompt": "Activer la publication automatique",

  // Auto Publish Enabled
  "settings_auto_publish_on_state": "Publication automatique activée",

  // Unfortunately Discord took our ability to preview your avatar. Click the link to see if it's working…
  "settings_botprofile_avatar_description": "Malheureusement, Discord nous a retiré la possibilité d'afficher un aperçu de ton avatar. Clique sur le lien pour voir s'il fonctionne…",

  // This does not look like a url
  "settings_botprofile_avatar_invalid_url_1": "Cela ne ressemble pas à une URL",

  // Please make sure your image actually loads and the link starts with `http://` or `https://`
  "settings_botprofile_avatar_invalid_url_2": "Assure-toi que ton image se charge bien et que le lien commence par `http://` ou `https://`",

  // Bot Avatar
  "settings_botprofile_avatar_label": "Avatar du bot",

  // Ayo what's that
  "settings_botprofile_avatar_url_too_long_1": "Hé ho, c'est quoi ça",

  // Your url is a little... excessive... A little... long, maybe. Could you try make it shorter maybe? Thanks :D
  "settings_botprofile_avatar_url_too_long_2": "Ton URL est un peu... démesurée... Un peu... longue, peut-être. Tu pourrais essayer de la raccourcir ? Merci :D",

  // Edit Avatar
  "settings_botprofile_btn_edit_avatar": "Modifier l'avatar",

  // Edit Name
  "settings_botprofile_btn_edit_name": "Modifier le nom",

  // (missing)
  "settings_botprofile_name_description": "",

  // Bot Name
  "settings_botprofile_name_label": "Nom du bot",

  // Uhhh, very sorry uhhh
  "settings_botprofile_name_too_long_1": "Euuuh, vraiment désolé euuuh",

  // But your name can only be 32 characters long. Directive from above, nothing I can do about that, sorry.
  "settings_botprofile_name_too_long_2": "Mais ton nom ne peut faire que 32 caractères maximum. Ordre d'en haut, impossible d'y faire quoi que ce soit, désolé.",

  // Avatar and Name
  "settings_botprofile_ui_1": "Avatar et nom",

  // Customize the bot's name and profile picture when sending notifications. Due to limitations with Discord this custom profile only applies to free game notifications, not when using commands like `/settings` or `/free`.
  "settings_botprofile_ui_2": "Personnalise le nom et la photo de profil du bot lors de l'envoi des notifications. En raison des limitations de Discord, ce profil personnalisé s'applique uniquement aux notifications de jeux gratuits, pas lors de l'utilisation de commandes comme `/settings` ou `/free`.",

  // Edit Avatar and Name
  "settings_change_bot_profile": "Modifier l'avatar et le nom",

  // You have too many webhooks in {channel}! Please open the channel settings, go to integrations, delete some unused webhooks, and come back. This limitation is enforced by Discord, we cannot do anything about this unfortunately.
  "settings_channel_error_too_many_webhooks": "Tu as trop de webhooks dans {channel} ! Ouvre les paramètres du salon, va dans intégrations, supprime quelques webhooks inutilisés, puis reviens. Cette limitation est imposée par Discord, nous ne pouvons malheureusement rien y faire.",

  // here
  "settings_channel_list_here": "ici",

  // You have too many channels to show them all in the list below.
  "settings_channel_list_too_many": "Tu as trop de salons pour qu'on puisse tous les afficher dans la liste ci-dessous.",

  // Missing \"Embed Messages\" Permission
  "settings_channel_list_warning_missing_embed_messages": "La permission \"Intégrer des liens\" est manquante",

  // Missing \"Manage Webhooks\" Permission
  "settings_channel_list_warning_missing_manage_webhooks": "Permission \"Gérer les webhooks\" manquante",

  // Missing \"Send Messages\" Permission
  "settings_channel_list_warning_missing_send_messages": "La permission \"Envoyer des messages\" est manquante",

  // Missing \"View Channel\" Permission
  "settings_channel_list_warning_missing_view_channel": "La permission \"Voir les salons\" est manquante",

  // You have waaaaay too many channels to show them all in the list below. How do you even find anything in here?
  "settings_channel_list_way_too_many": "Tu as beaaaucoup trop de salons pour qu'on puisse tous les afficher dans la liste ci-dessous. Comment tu fais pour retrouver quoi que ce soit là-dedans ?",

  // Change The Channel
  "settings_channel_ui_1": "Change de salon\n",

  // Below you'll find a list of all of your channels. Please pick one for me to send free games to!
  "settings_channel_ui_2_regular": "Vous trouverez ci-dessous une liste de tous vos salons. Veuillez en choisir un pour que je puisse y envoyer des jeux gratuits !",

  // Below you'll find a list of most of your channels. You had so many I couldn't show them all at once. Please pick one for me to send free games to!
  "settings_channel_ui_2_too_many": "Vous trouverez ci-dessous une liste de la plupart de vos salons. Vous en avez tellement que je n'ai pas pu les montrer toutes en même temps. Veuillez en choisir un pour que je puisse y envoyer des jeux gratuits !",

  // Below you'll find a list of a few of your channels. You have an enormous amount of channels in this server, you know this? So many in fact I could only show you a small selection of them. Please pick one for me to send free games to!
  "settings_channel_ui_2_way_too_many": "Vous trouverez ci-dessous une liste de quelques-uns de vos salons. Vous avez une quantité énorme de salons sur ce serveur, vous le savez ? Tellement en fait que je ne pourrais vous en montrer qu'une petite sélection. Veuillez en choisir un pour que je puisse y envoyer des jeux gratuits !",

  // Can't change channel to {channel}: Missing \"{permissions}\" permissions!
  "settings_channel_ui_missing_permissions": "Impossible de changer de salon pour {channel} : permissions \"{permissions}\" manquantes !",

  // If you cannot find your desired channel, run /settings in that very channel to force it to show up.
  "settings_channel_ui_too_many_channels_tip": "Le salon que vous souhaitez ne s'affiche pas ? Exécutez cette commande dans le salon auquel vous pensez pour qu'il apparaisse dans la liste !",

  // Unknown channel
  "settings_channel_unknown_channel": "Salon inconnu",

  // Other Settings
  "settings_conf_ui_1": "Autres paramètres",

  // **Select Language** will change the language notifications are shown in. This will **not** change the language of commands like /settings or /free. These use the same language you are using Discord in. Translations are community provided and might contain errors.\n\n**Select Currency** will change the currency in notifications. With some prices may get converted from other currencies or websites and thus might not always be 100% accurate.
  "settings_conf_ui_2": "**Choisir la langue** changera la langue dans laquelle les notifications s'affichent. Cela ne changera **pas** la langue des commandes comme /settings ou /free. Celles-ci utilisent la même langue que celle de ton Discord. Les traductions sont fournies par la communauté et peuvent contenir des erreurs.\n\n**Choisir la devise** changera la devise des notifications. Certains prix peuvent être convertis depuis d'autres devises ou sites web et peuvent ne pas être précis à 100 %.",

  // Change the currency in notifications. With some prices may get converted from other currencies or websites and thus might not always be 100% accurate.
  "settings_conf_ui_currency_description": "Change la devise dans les notifications. Certains prix peuvent être convertis depuis d'autres devises ou sites web et peuvent ne pas être précis à 100 %.",

  // Select Currency
  "settings_conf_ui_currency_label": "Sélectionner la devise",

  // Change the language notifications are shown in. This will **not** change the language of commands like /settings or /free. These use the same language you are using Discord in. Translations are community provided and might contain errors.
  "settings_conf_ui_language_description": "Change la langue dans laquelle les notifications s'affichent. Cela ne changera **pas** la langue des commandes comme /settings ou /free. Celles-ci utilisent la même langue que celle de ton Discord. Les traductions sont fournies par la communauté et peuvent contenir des erreurs.",

  // Select Language
  "settings_conf_ui_language_label": "Sélectionner la langue",

